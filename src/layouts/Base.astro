---
import "../styles.css";
import "../reach.css";
import { SITE_NAME, SITE_TAGLINE, SITE_THESIS } from "../lib/site";

const description = `${SITE_THESIS}. ${SITE_TAGLINE}`;
const canonical = "https://dominiondev.leraniode.org/";
const ogImage = `${canonical}og.png`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{SITE_NAME}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0C0C0E" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={SITE_NAME} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="> DominionDev_" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@dominionthedev" />
    <meta name="twitter:title" content={SITE_NAME} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="> DominionDev_" />
  </head>
  <body>
    <slot />
    <script src="../scripts/tour.ts"></script>
  </body>
</html>
